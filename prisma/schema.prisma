// MobilJuragan Prisma Schema (MariaDB / MySQL)
// - quoted_amount nullable: tarif sewa dikonfirmasi oleh tim/admin
// - vehicle_id merujuk pada 9 unit armada resmi MobilJuragan

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: connection handling dipindah ke prisma.config.ts (adapter @prisma/adapter-mariadb).
// Blok datasource di sini hanya menegaskan provider untuk editor/typegen.
datasource db {
  provider = "mysql"
}

/// Relasi antarmodel database:
/// User ▸ Booking ▸ (Vehicle, BookingStatusHistory)
/// User ▸ SupportTicket ▸ TicketMessage
/// User ▸ OtpVerification
/// AdminAction ▸ AuditLog

enum UserRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum BookingStatus {
  CREATED // booking diterima sistem, belum dikonfirmasi
  PENDING_CONFIRMATION // menunggu konfirmasi admin
  CONFIRMED // admin konfirmasi armada & tarif
  REJECTED
  CANCELLED
  IN_PROGRESS // penyewaan berjalan
  COMPLETED
}

enum BookingStatusActor {
  CUSTOMER
  STAFF
  ADMIN
  SYSTEM
}

enum RentalType {
  // kategori sewa; detail jenis final menyusul konfirmasi team/tarif
  WITH_DRIVER
  WITHOUT_DRIVER
}

enum OperationalStatus {
  AVAILABLE
  BOOKED
  MAINTENANCE
  UNAVAILABLE
}

enum TariffStatus {
  CONFIRMED
  PENDING_TEAM_CONFIRMATION
}

enum DriverRoute {
  DALAM_KOTA
  LUAR_KOTA
}

enum DriverReadiness {
  SIAGA
  LIBUR
  SEDANG_TUGAS
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketCategory {
  GENERAL
  PAYMENT_CONFIRMATION
  VEHICLE_ISSUE
  CANCELLATION
  COMPLAINT
  OTHER
}

enum PaymentStatus {
  UNPAID
  PENDING_VERIFICATION
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethod {
  QRIS
  BANK_TRANSFER
  CASH
}


model User {
  id            String    @id @default(uuid())
  fullName      String
  phoneNumber   String    @unique
  role          UserRole  @default(CUSTOMER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Optional credential khusus rol staff/admin (backend auth, bukan OTP customer).
  passwordHash  String?
  isActive      Boolean   @default(true)

  bookings      Booking[]
  tickets       SupportTicket[]
  sentMessages  TicketMessage[]
  otpVerifications OtpVerification[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Vehicle {
  id                String            @id @default(uuid())
  // Key referensi ke 9 armada resmi
  externalId        String            @unique
  name              String
  licensePlate      String
  brand             String?
  model             String?
  seatingCapacity   Int
  transmission      String? // AUTOMATIC | MANUAL
  category          String? // MENANGANI isi referensi fleet (towncar/pickup/man)
  imageUrl          String?
  pricePerDay       Int               @default(400000)
  operationalStatus OperationalStatus @default(AVAILABLE)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  bookings          Booking[]

  @@index([operationalStatus])
  @@index([externalId])
  @@map("vehicles")
}

/// Roster supir resmi MobilJuragan Merauke. Menopang layar Manajemen Supir (07),
/// modal M4 dan M5, serta pemilihan supir di Detail Pemesanan (04B) pada dashboard.
/// Kesiapan supir (SIAGA/LIBUR/SEDANG_TUGAS) menentukan apakah ia boleh ditugaskan.
model Driver {
  id            String          @id @default(uuid())
  /// Slug stabil untuk klien, misalnya markus-gebze.
  externalId    String          @unique
  fullName      String
  phoneNumber   String?
  licenseNumber String?
  routeScope    DriverRoute     @default(DALAM_KOTA)
  readiness     DriverReadiness @default(SIAGA)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  bookings      Booking[]

  @@index([readiness])
  @@index([isActive])
  @@map("drivers")
}

model Booking {
  id                  String             @id @default(uuid())
  bookingCode         String             @unique
  customerId          String
  customer            User               @relation(fields: [customerId], references: [id])
  vehicleId           String
  vehicle             Vehicle            @relation(fields: [vehicleId], references: [id])
  /// Supir hanya wajib untuk rentalType WITH_DRIVER, dan diisi saat konfirmasi.
  driverId            String?
  driver              Driver?            @relation(fields: [driverId], references: [id])

  startDateTime       DateTime
  endDateTime         DateTime
  rentalType          RentalType
  pickupLocation      String?
  customerRequest     String?
  numberGuests        Int?

  tariffStatus        TariffStatus       @default(PENDING_TEAM_CONFIRMATION)
  // Boleh null sampai tarif dikonfirmasi tim MobilJuragan.
  quotedAmount        Decimal?           @db.Decimal(12, 2)

  status              BookingStatus      @default(CREATED)
  statusHistory       BookingStatusHistory[]
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  payment             Payment?

  @@index([customerId])
  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
  @@index([startDateTime, endDateTime])
  @@map("bookings")
}

/// Riwayat tiap perubahan status booking (business rule minimum #5).
model BookingStatusHistory {
  id         String           @id @default(uuid())
  bookingId  String
  booking    Booking          @relation(fields: [bookingId], references: [id])
  fromStatus BookingStatus?
  toStatus   BookingStatus
  actor      BookingStatusActor
  actorUserId String?         // staff/admin/customer id saat ini
  note       String?          // catatan internal
  changedAt  DateTime         @default(now())

  @@index([bookingId])
  @@map("booking_status_history")
}

/// OTP customer authentication. HASH OTP saja; plaintext TIDAK disimpan demi keamanan.
model OtpVerification {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  phoneNumber   String    // nomor tujuan
  otpHash       String    // hanya hash (Argon2id saat backend auth diterapkan)
  purpose       String    // mis. "CUSTOMER_LOGIN" | "BOOKING_CONFIRM"
  expiresAt     DateTime
  attemptCount  Int       @default(0)
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId, phoneNumber])
  @@index([expiresAt])
  @@map("otp_verifications")
}

/// Penangan tiket. Tiket dari percakapan AI mulai dipegang AI; admin hanya boleh
/// membalas setelah AI menyerahkannya.
enum TicketHandler {
  AI
  HUMAN
}

model SupportTicket {
  id          String         @id @default(uuid())
  ticketNumber String        @unique
  customerId  String
  customer    User           @relation(fields: [customerId], references: [id])
  title       String
  category    TicketCategory
  description String
  status      TicketStatus   @default(OPEN)

  /// Tiket yang lahir dari percakapan AI dimulai dengan penangan AI. Tiket yang
  /// dibuat pelanggan langsung lewat formulir bantuan dimulai dengan penangan
  /// manusia, supaya alur lama tidak berubah.
  handledBy   TicketHandler  @default(HUMAN)

  /// Diisi saat AI menyerahkan tiket ke admin. Null berarti belum pernah
  /// diserahkan, dan selama itu balasan admin ditolak.
  handoverAt  DateTime?

  messages    TicketMessage[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([handledBy])
  @@map("support_tickets")
}

model TicketMessage {
  id          String        @id @default(uuid())
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id])

  /// Kosong untuk pesan yang dibuat asisten AI, karena tidak ada pengguna yang
  /// mengirimnya. Pesan dari pelanggan maupun tim selalu terisi.
  senderId    String?
  sender      User?         @relation(fields: [senderId], references: [id])

  body        String
  isCustomer  Boolean // pembeda arah pesan (independen saat backend; lihat catatan)

  /// Menandai balasan yang dihasilkan asisten AI, supaya riwayat percakapan bisa
  /// dibaca admin tanpa menebak mana yang dijawab mesin.
  isAi        Boolean       @default(false)

  sentAt      DateTime      @default(now())

  @@index([ticketId])
  @@map("ticket_messages")
}

/// Audit trail aktivitas penting admin (untuk staff/admin role).
model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String   // mis. "BOOKING_STATUS_CHANGED", "ADMIN_LOGIN"
  entityType String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}


/// Konfigurasi AI Gateway (9Router / LiteLLM / OpenRouter) & Parameter Model
model AiSetting {
  id                  String    @id @default("default")
  gatewayUrl          String    @default("http://localhost:20128/v1")
  apiKey              String?   @default("")
  activeModel         String    @default("gemini-2.5-flash")
  fallbackModel       String    @default("gemini-2.5-flash")
  fallbackGatewayUrl  String?   @default("https://generativelanguage.googleapis.com/v1beta/openai")
  fallbackApiKey      String?   @default("")
  autoFallbackEnabled Boolean   @default(true)
  proxyUrl            String?   @default("")
  healthStatus        String    @default("HEALTHY")
  lastLatencyMs       Int?      @default(0)
  lastHealthCheckedAt DateTime?
  systemPrompt        String    @db.Text
  temperature         Float     @default(0.7)
  maxTokens           Int       @default(1000)
  enableRag           Boolean   @default(true)
  updatedAt           DateTime  @updatedAt

  @@map("ai_settings")
}

/// Dokumen basis pengetahuan lokal (RAG Context) untuk asisten rental Merauke
model KnowledgeDocument {
  id        String   @id @default(uuid())
  title     String
  category  String   // SOP | ROUTE | TARIFF | EMERGENCY
  content   String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("knowledge_documents")
}

/// Tanya Jawab Umum (FAQ) Resmi MobilJuragan Merauke.
/// Ditampilkan dinamis di aplikasi mobile (HelpCenterScreen) dan diintegrasikan ke RAG AI Gateway.
model Faq {
  id          String   @id @default(uuid())
  question    String   @db.Text
  answer      String   @db.Text
  category    String   // 'Booking & Sewa' | 'Pembayaran' | 'Armada' | Kustom
  orderIndex  Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([orderIndex])
  @@map("faqs")
}

/// Pembayaran & Pemisahan Arus Kas Riil (Payment Lifecycle)
model Payment {
  id              String         @id @default(uuid())
  bookingId       String         @unique
  booking         Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  baseAmount      Decimal        @db.Decimal(12, 2)
  uniqueCode      Int            @default(0) // 1 s.d. 100 untuk pencocokan mutasi otomatis
  totalAmount     Decimal        @db.Decimal(12, 2) // baseAmount + uniqueCode

  method          PaymentMethod  @default(QRIS)
  status          PaymentStatus  @default(UNPAID)

  qrisPayload     String?        @db.Text
  proofImageUrl   String?        @db.Text
  bankName        String?
  senderAccount   String?

  verifiedAt      DateTime?
  verifiedBy      String?
  notes           String?        @db.Text
  expiresAt       DateTime?

  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([totalAmount])
  @@index([method])
  @@map("payments")
}


