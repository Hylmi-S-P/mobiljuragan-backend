# Template environment variable backend MobilJuragan
# Salin file ini ke `.env` lokal untuk pengembangan

DATABASE_URL="mysql://root:root@localhost:3306/mobiljuragan"

PORT=4000
APP_VERSION=dev
LOG_LEVEL=info

# Kredensial dan secret key development (ganti nilai di environment production)
JWT_SECRET="mobiljuragan-dev-jwt-secret-key"
OTP_SALT="mobiljuragan-dev-otp-salt-key"
SESSION_SECRET="CHANGE_ME_random_long_string"

# ---------------------------------------------------------------------------
# Wajib diisi saat NODE_ENV=production. Proses akan berhenti kalau kosong.
# ---------------------------------------------------------------------------

# Alamat bind. Kosongkan untuk pengembangan (0.0.0.0), isi 127.0.0.1 di server
# supaya backend hanya bisa dijangkau lewat Cloudflare Tunnel di mesin yang sama.
HOST=127.0.0.1

# Daftar asal yang boleh memanggil API dari peramban, dipisah koma.
# Tanpa ini di production, seluruh situs boleh memanggil API.
CORS_ORIGINS="https://mobiljuragan.tapakvia.com"

# Jumlah hop reverse proxy di depan Express. Cloudflare Tunnel menambah satu hop,
# sehingga `req.ip` berisi alamat asli pengunjung, bukan alamat tunnel.
TRUST_PROXY=1

# Penguncian akun saat login panel ditebak berulang kali.
# LOGIN_MAX_ATTEMPTS: jumlah kegagalan sebelum akun dikunci sementara.
# LOGIN_LOCK_MINUTES: lama penguncian dalam menit.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# JWT_SECRET dan OTP_SALT di production wajib minimal 32 karakter.
# Buat dengan: openssl rand -base64 48
# JWT_SECRET=
# OTP_SALT=

# ---------------------------------------------------------------------------
# Layanan pendukung
# ---------------------------------------------------------------------------

# Gateway WhatsApp untuk pengiriman OTP. Tanpa ini OTP gagal terkirim dan
# pelanggan tidak bisa masuk.
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=

# Tempat penyimpanan media di disk. Kosongkan untuk memakai <cwd>/storage/media.
# Di server, arahkan ke disk data terpisah supaya tidak ikut terhapus saat
# folder aplikasi diganti ketika deploy ulang.
MEDIA_DIR=

# MinIO belum dipakai. Driver penyimpanan yang aktif saat ini hanya `lokal`.
# Variabel di bawah disiapkan untuk pemindahan berikutnya.
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mobiljuragan-media

# Kunci penandatangan URL media privat. Minimal 32 karakter.
MEDIA_SIGNING_SECRET=
# Masa berlaku tautan media dalam detik.
MEDIA_URL_TTL_SECONDS=900

# Kode OTP pengembangan (123456). Hanya berlaku bila NODE_ENV bukan production
# DAN nilai ini "true". Biarkan kosong/false di server mana pun yang dipakai
# pelanggan sungguhan.
ALLOW_DEV_OTP_BYPASS=
