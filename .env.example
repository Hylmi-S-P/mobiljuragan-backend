# Template environment variable backend MobilJuragan
# Salin file ini ke `.env` lokal untuk pengembangan

DATABASE_URL="mysql://root:root@localhost:3306/mobiljuragan"

PORT=4000
APP_VERSION=dev
LOG_LEVEL=info

# Kredensial dan secret key development (ganti nilai di environment production)
JWT_SECRET="mobiljuragan-dev-jwt-secret-key"
OTP_SALT="mobiljuragan-dev-otp-salt-key"
SESSION_SECRET="CHANGE_ME_random_long_string"

# ---------------------------------------------------------------------------
# Wajib diisi saat NODE_ENV=production. Proses akan berhenti kalau kosong.
# ---------------------------------------------------------------------------

# Alamat bind. Kosongkan untuk pengembangan (0.0.0.0), isi 127.0.0.1 di server
# supaya backend hanya bisa dijangkau lewat Cloudflare Tunnel di mesin yang sama.
HOST=127.0.0.1

# Daftar asal yang boleh memanggil API dari peramban, dipisah koma.
# Tanpa ini di production, seluruh situs boleh memanggil API.
CORS_ORIGINS="https://mobiljuragan.tapakvia.com"

# Jumlah hop reverse proxy di depan Express. Cloudflare Tunnel menambah satu hop,
# sehingga `req.ip` berisi alamat asli pengunjung, bukan alamat tunnel.
TRUST_PROXY=1

# Penguncian akun saat login panel ditebak berulang kali.
# LOGIN_MAX_ATTEMPTS: jumlah kegagalan sebelum akun dikunci sementara.
# LOGIN_LOCK_MINUTES: lama penguncian dalam menit.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# JWT_SECRET dan OTP_SALT di production wajib minimal 32 karakter.
# Buat dengan: openssl rand -base64 48
# JWT_SECRET=
# OTP_SALT=

# ---------------------------------------------------------------------------
# Layanan pendukung
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Pengiriman OTP WhatsApp
# ---------------------------------------------------------------------------
# Penyedia OTP: `wapi` (WaPi.io), `gowa` (gateway WhatsApp Web), atau `off`.
# Kosongkan untuk menebak otomatis: WAPI_API_KEY lebih dulu, lalu WA_GATEWAY_URL.
WA_PROVIDER=

# --- WaPi.io (outbound OTP) -------------------------------------------------
# Isi WAPI_API_KEY dengan kunci `sk_live_...` dari konsol WaPi.io. Tanpa kunci
# ini OTP tidak terkirim dan pelanggan tidak bisa masuk.
WAPI_BASE_URL=https://wapi.sixsevensixseven.my.id/api/v1
WAPI_API_KEY=
# Jalur pengiriman OTP. Dokumentasi WaPi.io menyebut `/otp/send`, tetapi jalur
# yang benar-benar ada di server mereka adalah `/otp/outbound/send`.
WAPI_OTP_PATH=/otp/outbound/send

# --- Gateway WhatsApp Web (GOWA) --------------------------------------------
# Dipakai untuk pesan teks bebas (pemberitahuan perubahan identitas). Endpoint
# OTP WaPi.io hanya mengirim template, jadi pesan bebas tetap lewat gateway ini.
WA_GATEWAY_URL=
WA_GATEWAY_TOKEN=
# Kredensial perangkat gateway (dipakai bila gateway memakai sesi perangkat,
# bukan token tunggal). Isi hanya yang dipakai pemasangan Anda.
WA_GATEWAY_DEVICE_ID=
WA_GATEWAY_USER=
WA_GATEWAY_PASSWORD=

# Driver penyimpanan media: `lokal` atau `s3`.
# `lokal` menyimpan di disk mesin ini (cocok untuk satu laptop).
# `s3` berbicara protokol S3 — dipakai untuk MinIO saat pengembangan dan
# Cloudflare R2 saat produksi. Isi enam variabel S3_* di bawah bila memilih s3.
MEDIA_DRIVER=lokal

# Tempat penyimpanan media dan dokumen sewa di disk. Kosongkan untuk memakai
# <cwd>/storage/media. Dokumen sewa berada di subfolder `dokumen/` di akar yang
# sama. Hanya dipakai bila MEDIA_DRIVER=lokal.
# Di server, arahkan ke disk data terpisah supaya tidak ikut terhapus saat
# folder aplikasi diganti ketika deploy ulang.
MEDIA_DIR=

# --- Penyimpanan objek S3 (dipakai hanya bila MEDIA_DRIVER=s3) ---------------
# MinIO lokal:  S3_ENDPOINT=http://127.0.0.1:9000
# Cloudflare R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# Kosongkan S3_ENDPOINT untuk memakai AWS asli.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# MinIO dan R2 memerlukan path-style; AWS asli tidak. Default sesuai S3_ENDPOINT.
S3_FORCE_PATH_STYLE=true

# Kunci penandatangan URL media privat. Minimal 32 karakter.
MEDIA_SIGNING_SECRET=
# Masa berlaku tautan media dalam detik.
MEDIA_URL_TTL_SECONDS=900

# Batas unggahan berkas per pengguna: jumlah berkas per 10 menit.
# Kosongkan untuk memakai 20.
UPLOAD_RATE_MAX=

# Jarak antar sapuan penjadwal pesanan (tenggat dokumen, tagihan kedaluwarsa,
# sewa yang jadwalnya berakhir) dalam milidetik. Kosongkan untuk memakai
# 300000 (5 menit).
BOOKING_DEADLINE_INTERVAL_MS=

# Kode OTP pengembangan (123456). Hanya berlaku bila NODE_ENV bukan production
# DAN nilai ini "true". Biarkan kosong/false di server mana pun yang dipakai
# pelanggan sungguhan.
ALLOW_DEV_OTP_BYPASS=

# --- AI Gateway (9Router) ----------------------------------------------------
NINEROUTER_GATEWAY_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=mj
